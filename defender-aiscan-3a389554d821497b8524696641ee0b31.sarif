            "annotatedSource": "# [ENTRY] The public /login route is reachable by unauthenticated clients and is where the application begins creating authenticated session state.\n16: def login():\n17:     if request.method == \"POST\":\n18:         email = request.form.get(\"email\", \"\").strip().lower()\n19:         password = request.form.get(\"password\", \"\")\n20:         user = db.get_user_by_email(email)\n# [FLOW] Credentials are checked here, but this branch does not address whether the Flask session secret is deployment-unique.\n21:         if user and auth.verify_password(user, password):\n# [FLAG] This call stores the authenticated user in Flask session state, which is later trusted based on the configured SECRET_KEY.\n# [SINK] Authenticated identity is written into the session cookie trust boundary at this line.\n22:             auth.login_user(user)\n23:             return redirect(url_for(\"menus.dashboard\"))\n24:         flash(\"Invalid email or password.\")\n# [FLAG] Scanner-selected line.\n>>>25:     return render_template(\"login.html\")",
